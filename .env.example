# =============================================================================
# .env.example: the template for your Supabase keys (Session 2)
# =============================================================================
#
# How to use this file (Part 3, Steps 5 and 6 of the guide):
#
#   1. Make a copy of this file named .env.local
#        Windows (PowerShell):  Copy-Item .env.example .env.local
#        macOS or Linux:        cp .env.example .env.local
#   2. In your Supabase project, click Connect for the Project URL and the
#      publishable key. Find the secret key under Project Settings > API Keys.
#   3. Paste your values into .env.local, replacing the placeholders.
#   4. Add the same three names and values in Vercel
#      (Settings > Environment Variables), then redeploy.
#   5. Restart `npm run dev` so your computer picks up the new values.
#
# Until you do this, the site keeps working with the listings in
# content/listings.ts. Placeholder values below count as "not set up yet".
#
# Never commit .env.local. Git ignores it on purpose so your secret key never
# reaches GitHub. Only this template (with placeholders) is shared.
# -----------------------------------------------------------------------------


# --- Public: safe to show in the browser -------------------------------------
# Only these two names start with NEXT_PUBLIC_. That prefix tells Next.js it is
# fine to send them to visitors' browsers.

# Your Project URL. Example: https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# Your publishable key (starts with sb_publishable_). On older projects this is
# the "anon" key. It is public by design. The database security rules (RLS)
# protect your data, not this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"


# --- Secret: server only, never in the browser -------------------------------
# Your secret key (starts with sb_secret_). On older projects this is the
# "service_role" key. It can get past every security rule, so it stays on the
# server. Never add NEXT_PUBLIC_ to this name, and never paste it in a chat or
# commit it.

SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
